{
  "name": "@agentefer/root",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": "11.16.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "qs": "6.16.0",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "audit": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=high",
    "build": "npm run prepare:internal && npm run build --workspaces --if-present",
    "database:types:linked": "npm run build --workspace @agentefer/database && node ./scripts/sync-linked-database-types.mjs",
    "format": "prettier --write package.json dependency-policy.json tsconfig.base.json eslint.config.mjs prettier.config.mjs vitest.config.ts \"stryker*.config.mjs\" compose.yaml \".github/**/*.{yml,yaml}\" \"apps/**/package.json\" \"packages/**/*.{json,ts,tsx}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check package.json dependency-policy.json tsconfig.base.json eslint.config.mjs prettier.config.mjs vitest.config.ts \"stryker*.config.mjs\" compose.yaml \".github/**/*.{yml,yaml}\" \"apps/**/package.json\" \"packages/**/*.{json,ts,tsx}\" \"scripts/**/*.mjs\"",
    "lint": "npm run prepare:internal && eslint --no-error-on-unmatched-pattern eslint.config.mjs prettier.config.mjs \"scripts/**/*.mjs\" \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "prepare:internal": "node ./scripts/prepare-workspace-dependencies.mjs",
    "typecheck": "npm run prepare:internal && npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:process-runtime && npm run audit",
    "verify:ci-policy": "node ./scripts/verify-ci-policy.mjs",
    "verify:documentation-contract": "node ./scripts/verify-documentation-contract.mjs",
    "verify:workspace-gates": "node ./scripts/verify-workspace-gates.mjs",
    "verify:workspaces": "node ./scripts/verify-workspaces.mjs",
    "test": "npm run prepare:internal && npm run verify:workspaces && npm run verify:workspace-gates && npm run verify:workspace-build-graph && npm run verify:ci-policy && npm run verify:documentation-contract && npm run verify:acceptance-contract && npm run verify:container-contract && npm run verify:database-contract && npm run verify:dependency-policy && npm run test:coverage && npm run test:mutation && npm run test:mutation:b2-010 && npm run test:mutation:b4-005-b4-006 && npm run test:mutation:b4-005-b4-006-admin-catalog && npm run test:mutation:b4-007-facebook-oauth",
    "test:coverage": "vitest run --coverage",
    "test:database:linked": "npm run build --workspace @agentefer/database && node ./scripts/run-linked-pgtap.mjs",
    "test:database:linked:b3-001a-mutations": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-b3-001a-database-mutations.mjs",
    "test:database:linked:b3-002a-mutations": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-b3-002a-database-mutations.mjs",
    "test:database:linked:b2-010-mutations": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-b2-010-database-mutations.mjs",
    "test:database:linked:b4-007-mutations": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-b4-007-database-mutations.mjs",
    "test:database:linked:b3-001a-preparation-mutations": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-b3-001a-preparation-database-mutations.mjs",
    "test:database:linked:mutations": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-database-mutations.mjs",
    "test:database:linked:pending-mutations": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-pending-database-mutations.mjs",
    "test:database:linked:rehearsal": "npm run build --workspace @agentefer/database && node ./scripts/verify-linked-migration.mjs",
    "test:mutation": "stryker run",
    "test:mutation:b2-010": "stryker run stryker.b2-010.config.mjs",
    "test:mutation:b3-005": "stryker run stryker.b3-005.config.mjs",
    "test:mutation:b3-005-critical": "stryker run stryker.b3-005-critical.config.mjs",
    "test:mutation:b4-005-b4-006": "stryker run stryker.b4-005-b4-006.config.mjs",
    "test:mutation:b4-005-b4-006-admin-catalog": "stryker run stryker.b4-005-b4-006-admin-catalog.config.mjs",
    "test:mutation:b4-007-facebook-oauth": "stryker run stryker.b4-007-facebook-oauth.config.mjs",
    "test:mutation:b3-001a-preparation": "stryker run stryker.b3-001a-preparation.config.mjs",
    "verify:acceptance-contract": "node ./scripts/verify-acceptance-contract.mjs",
    "verify:container-contract": "node ./scripts/verify-container-contract.mjs",
    "verify:database-contract": "node ./scripts/verify-database-contract.mjs",
    "verify:dependency-policy": "node ./scripts/verify-dependency-policy.mjs",
    "verify:process-runtime": "node ./scripts/verify-process-runtime.mjs",
    "verify:workspace-build-graph": "node ./scripts/prepare-workspace-dependencies.mjs --verify"
  },
  "devDependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@eslint/js": "9.39.5",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
